# format used for printing the estimated completion time
import statistics
import sys
from collections.abc import Iterable
from dataclasses import dataclass
from datetime import datetime, timedelta
from pathlib import Path
from typing import NoReturn

import click
from rich.console import Console
from rich.table import Table
from rich.text import Text

from qq_lib.core.common import format_duration, get_info_files
from qq_lib.core.error import QQError
from qq_lib.info import Informer
from qq_lib.properties.info import Info
from qq_lib.properties.loop import LoopInfo
from qq_lib.properties.states import NaiveState, RealState

ETA_FORMAT = "%Y-%m-%d %H:%M"


@dataclass(frozen=True)
class CycleRecord:
    """
    Timing information about a single cycle of a loop job.
    """

    # cycle number
    cycle: int

    # state of the cycle according to its qq info file
    state: NaiveState

    # time the cycle was submitted
    submission_time: datetime

    # time `qq run` started, if it did
    start_time: datetime | None

    # time the cycle finished, failed, or was killed
    completion_time: datetime | None

    # main node the cycle ran on
    main_node: str | None

    @property
    def wait(self) -> timedelta | None:
        """
        Time between submission and the start of `qq run`, or None if the cycle has not started.
        """
        if self.start_time is None:
            return None

        return self.start_time - self.submission_time

    @property
    def run(self) -> timedelta | None:
        """
        Run time of a successfully finished cycle, or None if the cycle has not finished successfully.
        """
        if (
            self.state != NaiveState.FINISHED
            or self.start_time is None
            or self.completion_time is None
        ):
            return None

        return self.completion_time - self.start_time


@dataclass(frozen=True)
class LoopJob:
    """
    A loop job together with the history of its cycles.
    """

    # input directory of the loop job
    directory: Path

    # informer of the current cycle
    informer: Informer

    # current cycle number
    current: int

    # last cycle number
    end: int

    # all known cycles including the current one, sorted by cycle number
    cycles: list[CycleRecord]


@dataclass(frozen=True)
class LoopTiming:
    """
    Timing statistics and completion estimate for a loop job.
    """

    # input directory of the loop job
    directory: Path

    # real state of the current cycle
    state: RealState

    # current cycle number
    current: int

    # last cycle number
    end: int

    # median queue wait of the finished cycles
    median_wait: timedelta | None

    # median run time of the finished cycles
    median_run: timedelta | None

    # estimated time until the last cycle finishes
    remaining: timedelta | None

    # estimated completion time of the last cycle
    eta: datetime | None

    # finished cycles that ran considerably longer than the median
    slow_cycles: list[CycleRecord]


def list_info_files(directory: Path) -> list[Path]:
    """
    List qq info files in a directory, oldest first.
    """
    try:
        return get_info_files(directory)
    except OSError as e:
        raise QQError(f"Could not read directory '{directory}': {e}") from e


def read_infos(files: Iterable[Path]) -> list[Info]:
    """
    Load qq info files, skipping those that cannot be read.
    """
    infos: list[Info] = []
    for file in files:
        try:
            infos.append(Info.from_file(file))
        except QQError as e:
            print(f"Warning: {e.terminated}", file=sys.stderr)

    return infos


def find_current(infos: Iterable[Info]) -> tuple[Info, LoopInfo]:
    """
    Find the info of the current cycle of a loop job.
    """
    current: tuple[Info, LoopInfo] | None = None
    for info in infos:
        if (loop_info := info.loop_info) is None:
            continue
        if current is None or loop_info.current >= current[1].current:
            current = (info, loop_info)

    if current is None:
        raise QQError("No loop job found")

    return current


def to_record(info: Info) -> CycleRecord | None:
    """
    Convert the info of a loop job cycle into a cycle record.
    """
    if (loop_info := info.loop_info) is None:
        return None

    return CycleRecord(
        cycle=loop_info.current,
        state=info.job_state,
        submission_time=info.submission_time,
        start_time=info.start_time,
        completion_time=info.completion_time,
        main_node=info.main_node,
    )


def collect_cycles(infos: Iterable[Info], script_name: str) -> list[CycleRecord]:
    """
    Convert the infos of a loop job into one record per cycle.
    """
    by_cycle: dict[int, CycleRecord] = {}
    for info in infos:
        if info.script_name != script_name or (record := to_record(info)) is None:
            continue

        previous = by_cycle.get(record.cycle)
        if previous is None or record.submission_time > previous.submission_time:
            by_cycle[record.cycle] = record

    return [by_cycle[cycle] for cycle in sorted(by_cycle)]


def load_loop_job(directory: Path) -> LoopJob:
    """
    Load a loop job and the history of its cycles.
    """
    input_infos = read_infos(list_info_files(directory))
    if not input_infos:
        raise QQError("No qq job info file found")

    current, loop_info = find_current(input_infos)

    if loop_info.archive.is_dir():
        archive_infos = read_infos(list_info_files(loop_info.archive))
    else:
        archive_infos = []

    return LoopJob(
        directory=directory,
        informer=Informer(current),
        current=loop_info.current,
        end=loop_info.end,
        cycles=collect_cycles(input_infos + archive_infos, current.script_name),
    )


def load_loop_jobs(directories: Iterable[Path]) -> list[LoopJob]:
    """
    Load loop jobs from several directories.
    """
    jobs: list[LoopJob] = []
    for directory in directories:
        try:
            jobs.append(load_loop_job(directory))
        except QQError as e:
            print(f"Error: {directory}: {e.terminated}", file=sys.stderr)

    return jobs


def median_duration(durations: list[timedelta]) -> timedelta | None:
    """
    Compute the median of a list of durations.
    """
    if not durations:
        return None

    return timedelta(seconds=statistics.median(d.total_seconds() for d in durations))


def estimate_remaining(
    state: RealState,
    current: CycleRecord,
    end: int,
    median_wait: timedelta | None,
    median_run: timedelta | None,
    now: datetime,
) -> timedelta | None:
    """
    Estimate the time until the last cycle of a loop job finishes.

    Each cycle after the current one is assumed to wait for `median_wait`
    and run for `median_run`. For the current cycle, the time it has already
    spent in the queue or running is subtracted.
    """
    if median_wait is None or median_run is None:
        return None

    zero = timedelta(0)
    match state:
        case RealState.QUEUED | RealState.WAITING | RealState.BOOTING:
            waited = now - current.submission_time
            current_left = max(median_wait - waited, zero) + median_run
        case RealState.RUNNING if current.start_time is not None:
            running = now - current.start_time
            current_left = max(median_run - running, zero)
        case _:
            return None

    return current_left + (median_wait + median_run) * (end - current.cycle)


def compute_timing(
    job: LoopJob,
    state: RealState,
    now: datetime,
    last: int | None,
    slow_factor: float,
) -> LoopTiming:
    """
    Compute timing statistics and the completion estimate for a loop job.
    """
    finished = [cycle for cycle in job.cycles if cycle.run is not None]
    if last is not None:
        finished = finished[-last:]

    median_wait = median_duration(
        [wait for cycle in finished if (wait := cycle.wait) is not None]
    )
    median_run = median_duration(
        [run for cycle in finished if (run := cycle.run) is not None]
    )

    slow_cycles: list[CycleRecord] = []
    if median_run is not None:
        threshold = median_run * slow_factor
        slow_cycles = [
            cycle
            for cycle in finished
            if (run := cycle.run) is not None and run > threshold
        ]

    current = next((c for c in job.cycles if c.cycle == job.current), None)
    remaining = (
        estimate_remaining(state, current, job.end, median_wait, median_run, now)
        if current is not None
        else None
    )

    return LoopTiming(
        directory=job.directory,
        state=state,
        current=job.current,
        end=job.end,
        median_wait=median_wait,
        median_run=median_run,
        remaining=remaining,
        eta=now + remaining if remaining is not None else None,
        slow_cycles=slow_cycles,
    )


def format_optional_duration(duration: timedelta | None) -> str:
    """
    Format a duration for the output table.
    """
    return format_duration(duration) if duration is not None else "-"


def format_eta(timing: LoopTiming) -> str:
    """
    Format the estimated completion time for the output table.
    """
    if timing.state == RealState.FINISHED:
        return "done" if timing.current >= timing.end else "not resubmitted"

    if timing.eta is None:
        return "-"

    return timing.eta.strftime(ETA_FORMAT)


def create_summary_table(timings: Iterable[LoopTiming]) -> Table:
    """
    Create a table with one row per loop job.
    """
    table = Table(header_style="bold")
    table.add_column("Directory", justify="center")
    table.add_column("State", justify="center")
    table.add_column("Cycle", justify="center")
    table.add_column("Median wait", justify="center")
    table.add_column("Median run", justify="center")
    table.add_column("Remaining", justify="center")
    table.add_column("ETA", justify="center")

    for timing in timings:
        table.add_row(
            str(timing.directory),
            Text(str(timing.state), style=timing.state.color),
            f"{timing.current}/{timing.end}",
            format_optional_duration(timing.median_wait),
            format_optional_duration(timing.median_run),
            format_optional_duration(timing.remaining),
            format_eta(timing),
        )

    return table


def create_slow_cycles_table(timings: Iterable[LoopTiming]) -> Table:
    """
    Create a table listing the slow cycles of all loop jobs.
    """
    table = Table(title="Slow cycles", header_style="bold")
    table.add_column("Directory", justify="center")
    table.add_column("Cycle", justify="center")
    table.add_column("Run", justify="center")
    table.add_column("× median", justify="center")
    table.add_column("Node", justify="center")

    for timing in timings:
        if (median_run := timing.median_run) is None:
            continue

        for cycle in timing.slow_cycles:
            if (run := cycle.run) is None:
                continue

            table.add_row(
                str(timing.directory),
                str(cycle.cycle),
                format_duration(run),
                f"{run / median_run:.1f}",
                cycle.main_node or "-",
            )

    return table


@click.command(
    help="Show timing statistics and estimated completion times of qq loop jobs "
    "in the specified directories. If no directory is specified, the current "
    "directory is used.",
    context_settings={"help_option_names": ["-h", "--help"]},
)
@click.argument(
    "directories",
    nargs=-1,
    type=click.Path(exists=True, file_okay=False, path_type=Path),
)
@click.option(
    "--last",
    type=click.IntRange(min=1),
    default=None,
    help="Use only the last N finished cycles of each job. By default, all finished cycles are used.",
)
@click.option(
    "--slow-factor",
    type=click.FloatRange(min=1.0),
    default=1.5,
    show_default=True,
    help="Report finished cycles whose run time exceeds the median run time by this factor.",
)
def main(
    directories: tuple[Path, ...], last: int | None, slow_factor: float
) -> NoReturn:
    try:
        jobs = load_loop_jobs(directories or (Path.cwd(),))
        if not jobs:
            print("Error: No loop jobs found.", file=sys.stderr)
            sys.exit(1)

        # query the batch system once for all jobs
        Informer.set_batch_info_in_bulk([job.informer for job in jobs])

        now = datetime.now()
        timings = [
            compute_timing(job, job.informer.get_real_state(), now, last, slow_factor)
            for job in jobs
        ]

        console = Console()
        console.print(create_summary_table(timings))

        slow_table = create_slow_cycles_table(timings)
        if slow_table.row_count > 0:
            console.print()
            console.print(slow_table)

        sys.exit(0)
    except QQError as e:
        print(f"Error: {e.terminated}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
